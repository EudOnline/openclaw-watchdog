#!/usr/bin/env python3
from __future__ import annotations

import sys
from pathlib import Path

repo_root = Path(__file__).resolve().parents[2]
if str(repo_root) not in sys.path:
    sys.path.insert(0, str(repo_root))

from rehearsal.lib.rehearsal_common import ensure_runtime_layout, journal_log_path  # noqa: E402


def main() -> int:
    ensure_runtime_layout()
    tail_lines = 200
    args = sys.argv[1:]
    for index, arg in enumerate(args):
        if arg == "-n" and index + 1 < len(args):
            try:
                tail_lines = int(args[index + 1])
            except ValueError:
                tail_lines = 200
    path = journal_log_path()
    lines = path.read_text(encoding="utf-8", errors="replace").splitlines()[-tail_lines:]
    if lines:
        print("\n".join(lines))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

