#!/usr/bin/env python3
from __future__ import annotations

import os
import sys
import time
from pathlib import Path


def _response_file() -> Path:
    return Path(os.environ.get('HOME', '.')) / 'gemini-response.json'


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in {'--help', 'help'}:
        print('gemini shim')
        return 0
    if args[0] == '--version':
        print('gemini-shim 0.1.0')
        return 0
    if args[0] == '-p':
        response_file = _response_file()
        if response_file.exists():
            response_text = response_file.read_text(encoding='utf-8').strip()
            if response_text:
                print(response_text)
                return 0
        prompt = args[1] if len(args) > 1 else ''
        print('Gemini rehearsal shim accepted prompt')
        if prompt:
            print(prompt[:200])
        time.sleep(float(os.environ.get('GEMINI_SHIM_SLEEP_SECONDS', '1')))
        print('Gemini rehearsal shim completed')
        return 0
    print(f"gemini shim: unsupported args: {' '.join(args)}", file=sys.stderr)
    return 1


if __name__ == '__main__':
    raise SystemExit(main())
