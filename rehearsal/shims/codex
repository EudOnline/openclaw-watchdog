#!/usr/bin/env python3
from __future__ import annotations

import os
import sys
import time
from pathlib import Path

repo_root = Path(__file__).resolve().parents[2]
if str(repo_root) not in sys.path:
    sys.path.insert(0, str(repo_root))

from rehearsal.lib.rehearsal_common import append_line, codex_log_path, now_stamp  # noqa: E402


def _response_file() -> Path:
    return Path(os.environ.get('HOME', '.')) / 'codex-response.json'


def main() -> int:
    args = sys.argv[1:]
    append_line(codex_log_path(), f"[{now_stamp()}] argv={' '.join(args)}")
    if not args or args[0] in {'--help', 'help'}:
        print('codex shim')
        return 0
    if args[0] == '--version':
        print('codex-shim 0.1.0')
        return 0
    if args[0] == 'exec':
        response_file = _response_file()
        if response_file.exists():
            response_text = response_file.read_text(encoding='utf-8').strip()
            if response_text:
                print(response_text)
                return 0
        last_message_file = None
        prompt = args[-1] if args else ''
        for index, arg in enumerate(args):
            if arg == '-o' and index + 1 < len(args):
                last_message_file = args[index + 1]
        if last_message_file:
            Path(last_message_file).write_text('Codex rehearsal shim completed simulated analysis.\n', encoding='utf-8')
        print('Codex rehearsal shim accepted prompt')
        if prompt:
            print(prompt[:200])
        time.sleep(float(os.environ.get('CODEX_SHIM_SLEEP_SECONDS', '2')))
        print('Codex rehearsal shim completed')
        return 0
    print(f"codex shim: unsupported args: {' '.join(args)}", file=sys.stderr)
    return 1


if __name__ == '__main__':
    raise SystemExit(main())
