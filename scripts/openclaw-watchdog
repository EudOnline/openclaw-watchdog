#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="${REPO_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"

resolve_python() {
  if command -v python3.11 >/dev/null 2>&1; then
    printf '%s\n' "$(command -v python3.11)"
    return 0
  fi

  if command -v python3 >/dev/null 2>&1; then
    if python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
      printf '%s\n' "$(command -v python3)"
      return 0
    fi
  fi

  return 1
}

if ! PYTHON_BIN="$(resolve_python)"; then
  echo "openclaw-watchdog requires Python 3.11+." >&2
  echo "Install Python 3.11+ or invoke the module with a compatible interpreter, for example: python3.11 -m watchdog_v2 --help" >&2
  exit 1
fi

exec "$PYTHON_BIN" -m watchdog_v2 "$@"
