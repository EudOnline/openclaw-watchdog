OPENCLAW_CONFIG="~/.openclaw/openclaw.json"
OPENCODE_BOOTSTRAP_CONFIG_PATH="~/.config/opencode/opencode.json"
OPENCODE_BOOTSTRAP_MODEL="opencode/minimax-m2.5-free"

OPENCLAW_BOOTSTRAP_TIMEOUT_SECONDS="600"
OPENCLAW_BOOTSTRAP_LOG_FILE=""
OPENCLAW_BOOTSTRAP_QQBOT_APP_ID=""
OPENCLAW_BOOTSTRAP_QQBOT_CLIENT_SECRET=""
OPENCLAW_BOOTSTRAP_FEISHU_APP_ID=""
OPENCLAW_BOOTSTRAP_FEISHU_APP_SECRET=""
OPENCLAW_BOOTSTRAP_FEISHU_BOT_NAME="OpenClaw"
OPENCLAW_GATEWAY_PORT="18789"
OPENCLAW_GATEWAY_SERVICE="openclaw-gateway.service"

WATCHDOG_STATE_DIR="~/.openclaw-backup/watchdog"
WATCHDOG_LOG_FILE="~/.openclaw-backup/watchdog/watchdog.log"
WATCHDOG_EVENT_FILE="~/.openclaw-backup/watchdog/last-event.txt"
WATCHDOG_EVENT_HISTORY_FILE="~/.openclaw-backup/watchdog/event-history.jsonl"
WATCHDOG_EVENT_HISTORY_LIMIT="20"
WATCHDOG_RUN_STATE_FILE="~/.openclaw-backup/watchdog/run-state.json"
WATCHDOG_LAST_GOOD_CONFIG="~/.openclaw-backup/watchdog/openclaw.last-good.json"
WATCHDOG_LAST_GOOD_MANIFEST_FILE="~/.openclaw-backup/watchdog/last-good-manifest.json"
WATCHDOG_LAST_ROLLBACK_SUMMARY_FILE="~/.openclaw-backup/watchdog/last-rollback-summary.txt"
WATCHDOG_ROLLBACK_ARCHIVE_DIR="~/.openclaw-backup/watchdog/rollback-archives"
WATCHDOG_INCIDENTS_DIR="~/.openclaw-backup/watchdog/incidents"
WATCHDOG_INCIDENT_INDEX_FILE="~/.openclaw-backup/watchdog/incident-index.json"
WATCHDOG_INCIDENT_INDEX_LIMIT="20"
WATCHDOG_LAST_REPORT_FILE="~/.openclaw-backup/watchdog/last-report.json"
WATCHDOG_LAST_METRICS_FILE="~/.openclaw-backup/watchdog/last-metrics.json"
WATCHDOG_FAILURE_COUNT_FILE="~/.openclaw-backup/watchdog/consecutive-failures"
WATCHDOG_MAINTENANCE_FILE="~/.openclaw-backup/watchdog/maintenance-mode"
WATCHDOG_LOCK_FILE="~/.openclaw-backup/watchdog/watchdog.lock"

WATCHDOG_NOTIFY_CHANNEL=""
WATCHDOG_NOTIFY_TARGET=""
WATCHDOG_NOTIFY_ACCOUNT="default"
WATCHDOG_NOTIFY_ON_DEGRADED="true"
WATCHDOG_NOTIFY_ON_RECOVERY="true"
WATCHDOG_NOTIFY_ON_FAILURE="true"

WATCHDOG_ENABLE_PRE_REPAIR_BACKUP="false"
WATCHDOG_BACKUP_SCRIPT="./tools/openclaw-backup.js"
WATCHDOG_BACKUP_ENV_FILE="./config/openclaw-backup.env"
WATCHDOG_BACKUP_TIMEOUT_SECONDS="900"

WATCHDOG_RESTART_WAIT_SECONDS="12"
WATCHDOG_ACTIVE_NO_LISTENER_GRACE_SECONDS="3"
WATCHDOG_ENABLE_SERVICE_LEVEL_PROBE="true"
WATCHDOG_ENABLE_CONVERSATION_PROBE="true"
WATCHDOG_PRIMARY_CONVERSATION_TARGETS="gateway,channels"
WATCHDOG_MINIMAL_USABLE_ALLOW_OPTIONAL_FAILURES="true"
WATCHDOG_SERVICE_LEVEL_TIMEOUT_SECONDS="12"
WATCHDOG_SERVICE_LEVEL_RETRY_GRACE_SECONDS="8"
WATCHDOG_SERVICE_LEVEL_FAILURE_THRESHOLD="2"
WATCHDOG_ENABLE_SURVIVABILITY_FLOW="false"
WATCHDOG_ENABLE_SURVIVAL_MODE="false"
WATCHDOG_SURVIVAL_CONFIG_FILE="~/.openclaw-backup/watchdog/openclaw.survival.json"
WATCHDOG_SURVIVAL_STATE_FILE="~/.openclaw-backup/watchdog/survival-mode.json"
WATCHDOG_SURVIVAL_REQUIRED_CHANNELS="qqbot"
WATCHDOG_SURVIVAL_DISABLE_OPTIONAL_EXTENSIONS="false"
WATCHDOG_SURVIVAL_STABLE_READY_RUNS="2"
WATCHDOG_MESSAGE_TIMEOUT_SECONDS="20"
WATCHDOG_ENABLE_MESSAGE_LOOP_PROBE="false"
WATCHDOG_MESSAGE_LOOP_PROBE_ACCOUNT="default"
WATCHDOG_MESSAGE_LOOP_PROBE_CHANNEL=""
WATCHDOG_MESSAGE_LOOP_PROBE_TARGET=""
WATCHDOG_MESSAGE_LOOP_PROBE_REPLY_FROM=""
WATCHDOG_MESSAGE_LOOP_PROBE_EVENTS_FILE="~/.openclaw-backup/watchdog/message-loop-probe-events.jsonl"
WATCHDOG_MESSAGE_LOOP_PROBE_TIMEOUT_SECONDS="20"
WATCHDOG_MESSAGE_LOOP_PROBE_COOLDOWN_SECONDS="60"
WATCHDOG_DOCTOR_TIMEOUT_SECONDS="45"
WATCHDOG_ENABLE_DOCTOR_REPAIR="true"
WATCHDOG_KEEP_ROLLBACKS="10"
WATCHDOG_LAST_GOOD_GENERATIONS="5"
WATCHDOG_GUARD_MANIFEST_FILE="~/.openclaw-backup/watchdog/drift-guard.json"
WATCHDOG_PROTECTED_PATHS=""
WATCHDOG_ENABLE_DRIFT_AUTO_ROLLBACK="true"
WATCHDOG_KEEP_INCIDENTS="10"

WATCHDOG_CODEX_BIN="codex"
WATCHDOG_CODEX_MODEL_HINT="gpt-5.4-xhigh"
WATCHDOG_CODEX_WORKDIR="~"
WATCHDOG_CODEX_TIMEOUT_SECONDS="1800"
WATCHDOG_CLAUDE_CODE_BIN="claude"
WATCHDOG_CLAUDE_CODE_WORKDIR="~"
WATCHDOG_CLAUDE_CODE_TIMEOUT_SECONDS="1800"
WATCHDOG_GEMINI_CLI_BIN="gemini"
WATCHDOG_GEMINI_CLI_WORKDIR="~"
WATCHDOG_GEMINI_CLI_TIMEOUT_SECONDS="1800"
WATCHDOG_OPENCODE_BIN="opencode"
WATCHDOG_OPENCODE_WORKDIR="~"
WATCHDOG_OPENCODE_TIMEOUT_SECONDS="1800"
# Rescue order is fixed in code: codex -> claude-code -> gemini-cli -> opencode -> litellm -> rule-agent

WATCHDOG_LITELLM_ENABLED="false"
WATCHDOG_LITELLM_MODEL=""
WATCHDOG_LITELLM_API_BASE=""
WATCHDOG_LITELLM_API_KEY_ENV="OPENAI_API_KEY"
WATCHDOG_LITELLM_TIMEOUT_SECONDS="60"

WATCHDOG_RESCUE_KNOWLEDGE_ROOT="~/.openclaw-backup/watchdog/rescue"
WATCHDOG_RESCUE_CASES_DIR="~/.openclaw-backup/watchdog/rescue/cases"
WATCHDOG_RESCUE_CANDIDATE_RULES_DIR="~/.openclaw-backup/watchdog/rescue/candidate-rules"
WATCHDOG_RESCUE_RULES_DIR="~/.openclaw-backup/watchdog/rescue/rules"
WATCHDOG_RESCUE_REVIEWS_DIR="~/.openclaw-backup/watchdog/rescue/reviews"

# Explicit file allowlist for rescue config mutation.
# The dispatcher rejects plans outside this boundary before execution.
WATCHDOG_RESCUE_EDITABLE_PATHS="~/.openclaw/openclaw.json,~/.openclaw-backup/watchdog/openclaw.survival.json"

# Dotted-key allowlist uses exact-or-descendant matching.
# Example: allowing `channels` also allows `channels.qqbot.enabled`.
WATCHDOG_RESCUE_EDITABLE_KEYS="channels,extensions,mcpServers,services,workers,schedules"
