OPENCLAW_CONFIG="~/.openclaw/openclaw.json"
OPENCLAW_GATEWAY_PORT="18789"
OPENCLAW_GATEWAY_SERVICE="com.openclaw.gateway"

WATCHDOG_STATE_DIR="~/.openclaw-backup/watchdog"
WATCHDOG_LOG_FILE="~/.openclaw-backup/watchdog/watchdog.log"
WATCHDOG_EVENT_FILE="~/.openclaw-backup/watchdog/last-event.txt"
WATCHDOG_EVENT_HISTORY_FILE="~/.openclaw-backup/watchdog/event-history.jsonl"
WATCHDOG_RUN_STATE_FILE="~/.openclaw-backup/watchdog/run-state.json"
WATCHDOG_LAST_REPORT_FILE="~/.openclaw-backup/watchdog/last-report.json"
WATCHDOG_LAST_METRICS_FILE="~/.openclaw-backup/watchdog/last-metrics.json"
WATCHDOG_INCIDENTS_DIR="~/.openclaw-backup/watchdog/incidents"
WATCHDOG_INCIDENT_INDEX_FILE="~/.openclaw-backup/watchdog/incident-index.json"
WATCHDOG_MAINTENANCE_FILE="~/.openclaw-backup/watchdog/maintenance-mode"
WATCHDOG_LOCK_FILE="~/.openclaw-backup/watchdog/watchdog.lock"

WATCHDOG_ENABLE_PRE_REPAIR_BACKUP="false"
WATCHDOG_ACTIVE_NO_LISTENER_GRACE_SECONDS="30"
WATCHDOG_SERVICE_LEVEL_RETRY_GRACE_SECONDS="60"
WATCHDOG_SERVICE_LEVEL_FAILURE_THRESHOLD="6"
WATCHDOG_ENABLE_MODEL_HTTP_ERROR_FAILOVER="false"
WATCHDOG_MODEL_HTTP_ERROR_THRESHOLD="3"
WATCHDOG_MODEL_HTTP_ERROR_WINDOW_MINUTES="15"
WATCHDOG_MODEL_HTTP_ERROR_COOLDOWN_SECONDS="1800"
WATCHDOG_MODEL_FAILOVER_MAX_APPLIES_PER_DAY="3"
WATCHDOG_ENABLE_SURVIVABILITY_FLOW="false"
WATCHDOG_ENABLE_SURVIVAL_MODE="false"
WATCHDOG_PRIMARY_CONVERSATION_TARGETS="gateway,channels"
